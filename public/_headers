# Aset ber-hash dari Astro tidak pernah berubah isinya untuk nama yang sama,
# jadi aman disimpan setahun dan ditandai immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Huruf dan favicon jarang berganti dan namanya stabil, cukup sebulan.
/fonts/*
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/og.jpg
  Cache-Control: public, max-age=2592000

# HTML boleh disimpan sebentar tapi harus divalidasi ulang, supaya perubahan
# harga atau copy tidak tertahan di cache pengunjung.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
