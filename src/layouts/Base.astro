---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "id" | "en";
  /** Halaman tautan bio sengaja tidak diindeks supaya tidak menyaingi halaman utama. */
  noindex?: boolean;
  /** Padanan bahasa untuk hreflang: { en: "/", id: "/id/" } */
  alternate?: { id: string; en: string };
}

const {
  title = "Private Villa Sibentang",
  description = "Sembilan villa privat berkolam air panas alami di Cipanas, Garut.",
  lang = "en",
  noindex = false,
  alternate,
} = Astro.props;

const SITE = "https://sibentang.kampungsumberalam.com";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    {
      alternate && (
        <>
          <link rel="alternate" hreflang="en" href={SITE + alternate.en} />
          <link rel="alternate" hreflang="id" href={SITE + alternate.id} />
          <link rel="alternate" hreflang="x-default" href={SITE + alternate.en} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Private Villa Sibentang" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:url" content={SITE + Astro.url.pathname} />
    <meta property="og:image" content={SITE + "/og.jpg"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kolam air panas privat di Private Villa Sibentang, Cipanas, Garut" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={SITE + Astro.url.pathname} />
    <link
      rel="preload"
      href="/fonts/KumbhSans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#4E4117" />

    {/* Meta Pixel 1049322851258484. Dipasang di semua halaman, termasuk
        /link, karena halaman tautan bio itu justru pintu masuk trafik
        Instagram. `is:inline` wajib supaya Astro tidak membundel ulang
        cuplikan resmi Meta.

        Bedanya dengan cuplikan mentah cuma SATU: kapan fbevents.js diunduh.
        Cuplikan asli menyisipkannya seketika, dan itu terukur mahal di sini
        — fbevents.js 104KB plus satu berkas konfigurasi 63KB merebut main
        thread tepat di jendela LCP, terukur Render Delay 3,3 detik di
        Lighthouse mobile. Halaman ini nol JavaScript selain pixel, jadi
        seluruh ongkosnya kelihatan.

        Yang dilakukan di bawah: `fbq('init')` dan `fbq('track','PageView')`
        tetap dipanggil SEKETIKA seperti biasa. Pemanggilan itu masuk antrean
        `fbq.queue` bawaan Meta, lalu diputar ulang begitu pustakanya termuat,
        jadi urutan dan isi event-nya sama persis. Pustakanya sendiri baru
        diunduh setelah halaman selesai melukis, atau lebih cepat lagi kalau
        pengunjung menyentuh halaman duluan.

        Konsekuensinya jujur: pengunjung yang menutup tab dalam sedetik
        pertama tanpa menyentuh apa pun tidak terhitung. Kalau kamu lebih
        suka pixel menyala paling awal dan rela LCP naik, panggil saja
        `muat()` langsung tanpa penjadwalan. */}
    <link rel="preconnect" href="https://connect.facebook.net" />
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];f.__muatPixel=function(){if(f.__pixelDimuat)return;
      f.__pixelDimuat=1;t=b.createElement(e);t.async=!0;t.src=v;
      s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}}
      (window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');

      fbq('init', '1049322851258484');
      fbq('track', 'PageView');

      (function (w, d) {
        var muat = w.__muatPixel;
        if (d.readyState === 'complete') setTimeout(muat, 0);
        else w.addEventListener('load', function () { setTimeout(muat, 0); }, { once: true });
        ['pointerdown', 'keydown', 'touchstart'].forEach(function (ev) {
          w.addEventListener(ev, muat, { once: true, passive: true });
        });
      })(window, document);
    </script>

    <slot name="head" />
  </head>
  <body>
    <noscript
      ><img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src="https://www.facebook.com/tr?id=1049322851258484&ev=PageView&noscript=1"
      /></noscript
    >
    <slot />
  </body>
</html>
