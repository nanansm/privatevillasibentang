---
// Port dari prototipe <section class="paket" id="paket">: tiga kartu paket
// menginap (Thermal Reset / Deep Reset / Integration Reset), di-render dari
// copy.ts, bukan tiga blok hardcoded. TIDAK ADA harga di sini — tarif cuma
// dijawab lewat WhatsApp, tiap kartu bawa pesan WA-nya sendiri.
import { copy, type Lang } from "../i18n/copy";
import { waUrl } from "../config";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---

<section class="paket" id="paket">
  <!-- JANGAN tambahkan .wrap di sini. Seksinya sudah punya padding 5vw
       sendiri; .wrap menambah 5vw kedua sehingga grid menyempit 72px di
       tiap sisi pada layar 1440 dan kartunya jadi 364px, bukan 412px
       seperti rancangan. Referensi cuma memakai .paket-in. -->
  <div class="paket-in">
    <span class="paren rv">{t.paket.paren}</span>
    <h2 class="rv">{t.paket.h2}</h2>
    <p class="paket-lead rv">{t.paket.lead}</p>

    <div class="paket-grid">
      {t.paket.items.map((item) => (
        <div class="pcard rv">
          <div class="pcard-head">
            <span class="p-num">{item.numberLabel}</span>
            <h3>{item.name}</h3>
            <span class="p-dur">{item.duration}</span>
            <p class="p-tag">{item.tagline}</p>
          </div>
          <div class="pspec">
            <div class="s-label">Alur</div>
            <p>{item.alur}</p>
          </div>
          <div class="pspec">
            <div class="s-label">Signature Moments</div>
            <ul>
              {item.signatureMoments.map((m) => <li>{m}</li>)}
            </ul>
          </div>
          <div class="pspec">
            <div class="s-label">Termasuk</div>
            <ul>
              {item.termasuk.map((m) => <li>{m}</li>)}
            </ul>
          </div>
          <div class="pspec">
            <div class="s-label">Cocok Untuk</div>
            <p>{item.cocokUntuk}</p>
          </div>
          <a class="btn" href={waUrl(item.waMessage)} target="_blank" rel="noopener">
            {item.ctaLabel}
          </a>
        </div>
      ))}
    </div>

    <p class="paket-note rv">{t.paket.note}</p>
  </div>
</section>

<style>
  .paket {
    padding: clamp(5rem, 12vh, 9rem) 5vw;
    background: var(--sage);
  }
  .paket-in {
    max-width: var(--maxw);
    margin: 0 auto;
  }
  .paket .paren {
    display: block;
    margin-bottom: 14px;
    color: rgba(78, 65, 23, 0.55);
  }
  .paket h2 {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.12;
    max-width: 22ch;
  }
  .paket-lead {
    margin-top: 24px;
    max-width: 56ch;
    font-size: 16.5px;
    color: rgba(78, 65, 23, 0.85);
  }
  .paket-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: clamp(3rem, 7vh, 4.5rem);
    align-items: stretch;
  }
  @media (max-width: 960px) {
    .paket-grid {
      grid-template-columns: 1fr;
    }
  }
  .pcard {
    background: var(--paper);
    box-shadow: 0 24px 48px -24px rgba(63, 52, 18, 0.35);
    display: flex;
    flex-direction: column;
    padding: 0 30px 30px;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
  }
  .pcard:hover {
    transform: translateY(-6px);
    box-shadow: 0 34px 60px -26px rgba(63, 52, 18, 0.45);
  }
  .pcard-head {
    border-bottom: 1px solid var(--line);
    padding: 32px 30px 24px;
    margin: 0 -30px;
    background: linear-gradient(rgba(206, 205, 178, 0.35), rgba(206, 205, 178, 0));
  }
  .pcard-head .p-num {
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--olive);
    font-weight: 600;
  }
  .pcard-head h3 {
    font-size: 26px;
    font-weight: 600;
    margin-top: 10px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .pcard-head .p-dur {
    display: inline-block;
    margin-top: 12px;
    border: 1px solid rgba(78, 65, 23, 0.35);
    padding: 5px 12px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .pcard-head .p-tag {
    font-size: 13.5px;
    font-style: italic;
    color: rgba(78, 65, 23, 0.65);
    margin-top: 14px;
  }
  .pspec {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .pspec:last-of-type {
    border-bottom: none;
    margin-bottom: 26px;
  }
  .pspec .s-label {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--olive);
    margin-bottom: 10px;
  }
  .pspec p {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(78, 65, 23, 0.85);
  }
  .pspec ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .pspec ul li {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(78, 65, 23, 0.85);
    padding-left: 16px;
    position: relative;
  }
  .pspec ul li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--olive);
  }
  .pcard .btn {
    margin-top: auto;
    width: 100%;
  }
  .paket-note {
    margin-top: 36px;
    font-size: 13.5px;
    color: rgba(78, 65, 23, 0.65);
    max-width: 52ch;
  }
</style>
