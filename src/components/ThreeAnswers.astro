---
// Empat pertanyaan nyata, dijawab langsung.
// Accordion pakai <details>/<summary> bawaan HTML: buka-tutupnya jalan tanpa
// satu baris JavaScript pun, dan tetap bisa dibuka lewat keyboard.
import { copy, type Lang } from "../i18n/copy";
import { waUrl } from "../config";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---

<section class="mx-auto mt-24 w-full max-w-[76rem] px-6 md:mt-40 md:px-10 md:grid md:grid-cols-12 md:gap-x-10">
  <div class="md:col-span-5">
    <h2
      class="muncul max-w-[17ch] text-[29px] leading-[1.15] font-bold tracking-[-0.02em] text-balance text-ink md:text-[44px] md:leading-[1.08]"
    >
      {t.faq.h2}
    </h2>
  </div>

  <div class="md:col-span-7">
    <div class="muncul mt-8 md:mt-0">
      {
        t.faq.items.map((item, i) => (
          <details class="group border-t border-rule last:border-b" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-[17px] leading-[1.35] font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <span
                class="shrink-0 text-[22px] leading-none font-normal text-olive group-open:hidden"
                aria-hidden="true"
              >
                +
              </span>
              <span
                class="hidden shrink-0 text-[22px] leading-none font-normal text-olive group-open:block"
                aria-hidden="true"
              >
                &#8722;
              </span>
            </summary>
            <p class="max-w-[38ch] pb-6 text-base leading-[1.55] text-ink">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>

    <a
      href={waUrl(t.faq.waMessage)}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-block text-[17px] underline underline-offset-4 text-ink"
    >
      {t.faq.ctaLabel}
    </a>
  </div>
</section>
