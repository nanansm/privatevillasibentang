---
// Tiga journey, tanpa harga — cuma kode durasi, nama, dan deskripsi.
// Tiap paket dipisah hairline, bukan kartu, biar sejalan sama daftar villa
// di atasnya. Ajakan booking langsung ke WhatsApp per paket, tanpa tombol.
import { Picture } from "astro:assets";
import cangkir from "../assets/photos/mote-9717.jpg";
import { copy, type Lang } from "../i18n/copy";
import { waUrl } from "../config";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

const altCangkir =
  lang === "en"
    ? "A woman sitting at the pool's edge holding a teacup."
    : "Perempuan duduk di tepi kolam sambil memegang cangkir teh.";
---

<section class="mt-24 md:mt-40">
  <div class="mx-auto w-full max-w-[76rem] px-6 md:px-10 md:grid md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-5 md:row-start-1">
      <h2
        class="muncul max-w-[17ch] text-[29px] leading-[1.15] font-bold tracking-[-0.02em] text-balance text-ink md:text-[44px] md:leading-[1.08]"
      >
        {t.journeys.h2}
      </h2>
      <p class="muncul mt-5 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
        {t.journeys.intro}
      </p>
    </div>

    <div class="md:col-span-7 md:col-start-6 md:row-start-1 md:row-span-2">
      {
        t.journeys.items.map((item) => (
          <div class="muncul mt-6 border-t border-rule pt-6">
            <span class="block text-[36px] leading-none font-bold text-olive md:text-[56px]">
              {item.code}
            </span>
            <span class="mt-2 block text-[17px] font-semibold text-ink">
              {item.name}
            </span>
            <p class="mt-2 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
              {item.desc}
            </p>
            <a
              href={waUrl(item.waMessage)}
              class="mt-3 inline-block text-[17px] text-ink underline underline-offset-2"
            >
              {item.waLabel}
            </a>
          </div>
        ))
      }
    </div>

    <div class="muncul mt-10 md:col-span-5 md:row-start-2 md:mt-10">
      <Picture
        src={cangkir}
        alt={altCangkir}
        widths={[300, 600, 800]}
        sizes="(min-width: 768px) 40vw, 100vw"
        formats={["avif", "webp"]}
        loading="lazy"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>
