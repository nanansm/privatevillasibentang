---
// Rakitan homepage tunggal, dipakai index.astro (EN) dan id/index.astro (ID)
// dengan prop lang saja, nol duplikasi markup.
//
// Fase plumbing loader+nav+hero (14 Agu 2026): Loader lalu Hero (yang
// merender SiteHeader di dalamnya), sisa <main> masih kosong menunggu
// section berikutnya. Komponen section lama (HeroSpring, NoQueue,
// FlowerRegistry, InsideVilla, ThermalJourneys, OneGate, ThreeAnswers,
// BookingBand) sengaja TIDAK diimpor lagi di sini tapi filenya belum
// dihapus — itu tugas fase lain.
import Base from "../layouts/Base.astro";
import Loader from "./Loader.astro";
import Hero from "./Hero.astro";
import Statement from "./Statement.astro";
import Landasan from "./Landasan.astro";
import Moments from "./Moments.astro";
import Cards from "./Cards.astro";
import Units from "./Units.astro";
import Faq from "./Faq.astro";
import Paket from "./Paket.astro";
import Contact from "./Contact.astro";
import { copy, type Lang } from "../i18n/copy";
import {
  SITE_URL,
  ALAMAT,
  WA_NUMBER,
  IG_URL,
  TRAVELOKA_URL,
  AGODA_URL,
} from "../config";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

// JSON-LD LodgingBusiness. Sengaja TANPA aggregateRating (klien minta
// dibuang) dan TANPA geo, belum ada koordinat terverifikasi untuk lokasi
// persis, dan blueprint melarang mengarang data.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: "Private Villa Sibentang",
  url: SITE_URL + (lang === "en" ? "/" : "/id/"),
  telephone: `+${WA_NUMBER}`,
  address: {
    "@type": "PostalAddress",
    streetAddress: ALAMAT,
    addressLocality: "Tarogong Kaler",
    addressRegion: "Garut",
    postalCode: "44151",
    addressCountry: "ID",
  },
  // priceRange sengaja dihapus 14 Agu 2026: tarif ikut tanggal dan semua
  // pertanyaan harga diarahkan ke WhatsApp, jadi memasang angka di sini
  // cuma menanam data yang bakal basi tanpa ada yang merawatnya.
  image: SITE_URL + "/og.jpg",
  containedInPlace: {
    "@type": "Resort",
    name: "Kampung Sumber Alam Resort",
  },
  sameAs: [IG_URL, TRAVELOKA_URL, AGODA_URL],
};

// JSON-LD FAQPage, di-generate persis dari t.faq.items yang tampil di
// halaman — jangan hardcode ulang teksnya di sini.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: t.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  alternate={{ en: "/", id: "/id/" }}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <div class="grain" aria-hidden="true"></div>
  <Loader />
  <main>
    <Hero lang={lang} />
    <!-- Urutan seksi mengikuti rancangan tim persis: Jawaban (FAQ) memang
         datang SEBELUM Paket, walau daftar tautan di nav menyebut Paket
         lebih dulu. Perbedaan itu ada di berkas aslinya, tidak dikarang
         di sini. -->
    <Statement lang={lang} />
    <Landasan lang={lang} />
    <Moments lang={lang} />
    <Cards lang={lang} />
    <Units lang={lang} />
    <Faq lang={lang} />
    <Paket lang={lang} />
    <Contact lang={lang} />
  </main>
</Base>

<script>
  // Satu pengamat untuk SEMUA elemen .rv di halaman. Sengaja dipusatkan di
  // sini, bukan satu observer per komponen: sembilan observer mengerjakan
  // pekerjaan yang sama dan menambah kerja main thread tanpa alasan.
  //
  // Yang sudah kelewat di atas layar saat skrip jalan langsung ditandai
  // 'in' oleh observer pada callback pertama, jadi tidak ada seksi yang
  // tertinggal kosong kalau pengunjung memuat halaman di posisi tengah.
  const rv = document.querySelectorAll<HTMLElement>(".rv");
  if (rv.length) {
    const kurangiGerak = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (kurangiGerak) {
      // global.css sudah menetralkan transisinya; kelasnya tetap dipasang
      // supaya keadaan akhir sama persis dengan jalur beranimasi.
      rv.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("in");
            io.unobserve(e.target);
          });
        },
        { threshold: 0.12 },
      );
      rv.forEach((el) => io.observe(el));
    }
  }
</script>
