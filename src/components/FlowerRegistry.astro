---
// Register sembilan bunga. Ini titik berat halaman.
// Tiap unit jadi satu bidang sage yang berdiri sendiri, bukan baris daftar.
// Alasannya dua: deck menyuruh "blok warna sebagai penambat, objek disusun
// bukan dijejer", dan sembilan baris berhairline adalah tata letak paling
// malas yang ada. Ikonnya plakat pintu, dibuktikan foto unit Lily di bawah.
import { Picture } from "astro:assets";
import melati from "../assets/brand/unit-melati.svg?raw";
import aster from "../assets/brand/unit-aster.svg?raw";
import asoka from "../assets/brand/unit-asoka.svg?raw";
import mawar from "../assets/brand/unit-mawar.svg?raw";
import padma from "../assets/brand/unit-padma.svg?raw";
import seruni from "../assets/brand/unit-seruni.svg?raw";
import cendana from "../assets/brand/unit-cendana.svg?raw";
import lily from "../assets/brand/unit-lily.svg?raw";
import anggrek from "../assets/brand/unit-anggrek.svg?raw";
import pintuLily from "../assets/photos/mote-9739.jpg";
import { copy, type Lang } from "../i18n/copy";
import { PRICE_FROM_1BR, PRICE_FROM_2BR, formatIDR, waUrl } from "../config";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

const grup1 = [
  { nama: "Melati", svg: melati },
  { nama: "Aster", svg: aster },
  { nama: "Asoka", svg: asoka },
  { nama: "Mawar", svg: mawar },
];
const grup2 = [
  { nama: "Padma", svg: padma },
  { nama: "Seruni", svg: seruni },
  { nama: "Cendana", svg: cendana },
  { nama: "Lily", svg: lily },
  { nama: "Anggrek", svg: anggrek },
];

const alt =
  lang === "en"
    ? "The door of the Lily villa, with its flower-name plaque mounted beside it."
    : "Pintu villa Lily, lengkap dengan plakat nama bunganya.";
---

<section id="villas" class="mt-24 md:mt-40">
  <div class="mx-auto w-full max-w-[76rem] px-6 md:px-10">
    <div class="muncul md:grid md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-5">
    <h2
      class="max-w-[17ch] text-[29px] leading-[1.15] font-bold tracking-[-0.02em] text-balance text-ink md:text-[44px] md:leading-[1.08]"
    >
      {t.registry.h2}
    </h2>
    <p class="mt-5 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
      {t.registry.body}
    </p>
    <p class="mt-3 max-w-[38ch] text-[13px] leading-[1.5] text-ink-2">
      {t.registry.dynamicNote}
    </p>
    </div>

    <div class="md:col-span-7">
    <div class="mt-12 md:mt-0">
      <h3 class="text-[17px] leading-[1.35] font-semibold text-ink">
        {t.registry.group1Label}
      </h3>
      {
        PRICE_FROM_1BR > 0 && (
          <>
            <p class="mt-1 text-xl leading-[1.3] font-bold text-olive">
              {t.registry.priceFromWord} {formatIDR(PRICE_FROM_1BR)}{" "}
              {t.registry.priceSuffix}
            </p>
          </>
        )
      }
      <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-2">
        {
          grup1.map((u) => (
            <div class="flex min-h-[124px] md:min-h-[150px] flex-col justify-between bg-sage/45 p-4">
              <span
                class="h-14 w-14 text-olive [&>svg]:h-full [&>svg]:w-full"
                set:html={u.svg}
              />
              <span class="mt-4 text-[17px] leading-[1.2] font-semibold text-ink">
                {u.nama}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12">
      <h3 class="text-[17px] leading-[1.35] font-semibold text-ink">
        {t.registry.group2Label}
      </h3>
      {
        PRICE_FROM_2BR > 0 && (
          <>
            <p class="mt-1 text-xl leading-[1.3] font-bold text-olive">
              {t.registry.priceFromWord} {formatIDR(PRICE_FROM_2BR)}{" "}
              {t.registry.priceSuffix}
            </p>
          </>
        )
      }
      <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-2">
        {
          grup2.map((u) => (
            <div class="flex min-h-[124px] flex-col justify-between bg-sage/45 p-4 md:min-h-[150px]">
              <span
                class="h-14 w-14 text-olive [&>svg]:h-full [&>svg]:w-full"
                set:html={u.svg}
              />
              <span class="mt-4 text-[17px] leading-[1.2] font-semibold text-ink">
                {u.nama}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <a
      href={waUrl(t.registry.waMessage)}
      target="_blank"
      rel="noopener"
      class="mt-8 inline-block text-[17px] underline underline-offset-4 text-ink"
    >
      {t.registry.ctaLabel}
    </a>

    <figure class="mt-16">
      <Picture
        src={pintuLily}
        alt={alt}
        widths={[390, 640, 780, 880]}
        sizes="(min-width:1216px) 646px, (min-width:768px) 55vw, calc(100vw - 3rem)"
        formats={["avif", "webp"]}
        loading="lazy"
        class="h-auto w-full"
      />
      <figcaption class="mt-3 text-[13px] leading-[1.5] text-ink-2">
        {t.registry.caption}
      </figcaption>
    </figure>
    </div>
    </div>
  </div>
</section>
