---
// Faq (jawaban): grid statis dua kolom, tanpa accordion, tanpa JS. Port dari
// prototipe <section class="faq" id="jawaban">.
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang].faq;
---

<section class="faq" id="jawaban">
  <div class="faq-in">
    <span class="paren rv">{t.paren}</span>
    <h2 class="rv">{t.h2}</h2>
    <div class="faq-list">
      {t.items.map((item) => (
        <div class="faq-row rv">
          <div class="faq-q">{item.q}</div>
          <div class="faq-a">{item.a}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding: clamp(4rem, 10vh, 8rem) 5vw clamp(6rem, 14vh, 10rem); }
  .faq-in { max-width: var(--maxw); margin: 0 auto; }
  .faq .paren { display: block; margin-bottom: 14px; }
  .faq h2 { font-size: clamp(2rem, 4.2vw, 3.4rem); font-weight: 500; letter-spacing: -.02em; line-height: 1.12; max-width: 22ch; }
  .faq-list { margin-top: clamp(2.5rem, 6vh, 4rem); border-top: 1px solid var(--line); }
  .faq-row { display: grid; grid-template-columns: 1fr 1.2fr; gap: 4vw; padding: 34px 0; border-bottom: 1px solid var(--line); }
  @media (max-width: 820px) { .faq-row { grid-template-columns: 1fr; gap: 10px; padding: 26px 0; } }
  .faq-q { font-size: clamp(1.15rem, 1.8vw, 1.5rem); font-weight: 500; letter-spacing: -.01em; max-width: 24ch; }
  .faq-a { font-size: 15px; color: rgba(78, 65, 23, .75); max-width: 60ch; align-self: center; }
</style>
