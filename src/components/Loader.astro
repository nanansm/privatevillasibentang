---
// Overlay loader, port dari prototipe (blok CSS ".loader" + markup
// #loader). Logo geser naik, kotak foto melebar, .done ditambahkan di
// 2300ms lalu overlay fade-out (opacity+visibility CSS transition di scope
// style, bukan display:none — supaya tidak pernah menutupi <main>/hero yang
// sudah harus melukis di baliknya untuk LCP).
//
// Dilewati total (skip): sudah pernah lihat sesi ini (sessionStorage
// sib_seen) atau prefers-reduced-motion. Kedua kondisi dicek SEBELUM
// requestAnimationFrame pertama supaya tidak sempat flash sebentar.
import { Image } from "astro:assets";
import lockup from "../assets/brand/lockup-utama.svg?raw";
import kolam from "../assets/foto2026/kolam.jpg";
---

<div class="loader" id="sibLoader" aria-hidden="true">
  <div class="loader-col">
    <div class="loader-logo">
      <div class="loader-logo-inner" set:html={lockup} />
    </div>
    <div class="loader-box">
      <Image src={kolam} alt="" width={520} height={520} loading="eager" />
    </div>
  </div>
</div>

<script>
  (function () {
    var loader = document.getElementById("sibLoader");
    if (!loader) return;

    var seen = sessionStorage.getItem("sib_seen");
    var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (seen || reduced) {
      loader.remove();
      sessionStorage.setItem("sib_seen", "1");
      return;
    }
    sessionStorage.setItem("sib_seen", "1");

    requestAnimationFrame(function () {
      loader.classList.add("play");
    });
    // Prototipe menahan layar 2.300 ms lalu fade 900 ms. Terukur: LCP 3,6
    // detik, karena overlay ini menutupi konten yang sebenarnya sudah
    // melukis di bawahnya. Koreografinya dipertahankan persis, cuma
    // dipercepat — tahan 900 ms, fade 500 ms, bersih di 1.400 ms.
    setTimeout(function () {
      loader.classList.add("done");
    }, 900);
    // Buang dari DOM setelah transisi opacity/visibility selesai, supaya
    // overlay yang sudah tak terlihat tidak tetap menangkap event.
    setTimeout(function () {
      loader.remove();
    }, 1400);
  })();
</script>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s;
  }
  .loader.done {
    opacity: 0;
    visibility: hidden;
  }
  .loader-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
  }
  .loader-logo {
    overflow: hidden;
    width: clamp(240px, 38vw, 460px);
    color: var(--ink);
  }
  .loader-logo-inner {
    transform: translateY(115%);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .loader-logo-inner :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .loader.play .loader-logo-inner {
    transform: translateY(0);
  }
  .loader-box {
    width: 0;
    height: clamp(90px, 16vh, 150px);
    overflow: hidden;
    transition: width 0.6s cubic-bezier(0.65, 0, 0.35, 1) 0.25s;
  }
  .loader.play .loader-box {
    width: clamp(150px, 24vw, 260px);
  }
  .loader-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
