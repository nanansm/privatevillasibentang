---
// Satu layar menjawab "ini apa". Teks berdiri sendiri di atas putih, foto
// menyusul di bawahnya — tidak ada teks menumpang foto, jadi nol scrim.
//
// Dua keputusan yang diukur, bukan dikira:
// 1. Grid hero dulu `[1fr_480px]`, sementara SELURUH section lain 12 kolom.
//    Terukur: kolom kanan hero mulai di x=808, section lain x=642 — meleset
//    166px dan itu tepi paling atas yang dilihat orang. Sekarang ikut 12
//    kolom yang sama, jadi tepinya satu garis dari hero sampai penutup.
// 2. Tautan "lihat sembilan villa" turun ke bawah foto di mobile. Foto naik
//    ~50px, jadi bagian berkolam di fotonya kebaca di layar pertama 390x844
//    tanpa satu piksel pun dipotong.
import { Picture } from "astro:assets";
import foto from "../assets/photos/mote-9760.jpg";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

const alt =
  lang === "en"
    ? "A Sibentang villa with its own hot spring pool in the yard, thatched roof and louvred doors."
    : "Villa Sibentang dengan kolam air panasnya sendiri di halaman, atap alang-alang dan pintu berkisi.";
---

<section class="w-full pt-12 md:pt-20">
  <div class="mx-auto flex w-full max-w-[76rem] flex-col px-6 md:grid md:grid-cols-12 md:items-center md:gap-x-10 md:px-10">
    <div class="md:col-span-5 md:row-start-1">
      <p class="text-[12px] leading-[1.2] font-semibold tracking-[0.16em] text-ink-2 uppercase">
        {t.hero.kicker}
      </p>

      <h1 class="mt-4 max-w-[15ch] text-[40px] leading-[1.05] font-bold tracking-[-0.02em] text-ink md:text-[60px] md:leading-[1.02]">
        {t.hero.h1}
      </h1>

      <p class="mt-5 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
        {t.hero.sub}
      </p>
    </div>

    <div class="mt-8 md:col-span-7 md:col-start-6 md:row-span-2 md:row-start-1 md:mt-0">
      <Picture
        src={foto}
        alt={alt}
        widths={[390, 640, 780, 1170]}
        sizes="(min-width:1216px) 646px, (min-width:768px) 55vw, calc(100vw - 3rem)"
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>

    <a
      href="#villas"
      class="mt-6 inline-block self-start text-[17px] underline underline-offset-4 md:col-span-5 md:row-start-2 md:mt-8"
    >
      {t.hero.villasLink}
    </a>
  </div>
</section>
