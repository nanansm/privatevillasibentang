---
// Identitas dan saklar bahasa, bar statis putih di atas hero. Nol JS,
// nol hamburger.
//
// Deskriptor di bawah wordmark sengaja ada: kata "Sibentang" saja tidak
// memberi tahu pendatang baru bahwa ini penginapan, dan sebelum ini satu
// satunya penjelas ada di h1 yang belum tentu dibaca. Ditulis huruf biasa,
// bukan kapital berjarak, supaya jatah penanda kapital halaman tidak
// bertambah.
import wordmark from "../assets/brand/wordmark.svg?raw";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---

<header class="border-b border-rule">
  <div class="mx-auto flex w-full max-w-[76rem] items-center justify-between gap-4 px-6 py-3 md:px-10">
    <div class="flex min-w-0 flex-col gap-1">
      <a href={lang === "en" ? "/" : "/id/"} class="block w-24 shrink-0 text-ink [&>svg]:h-auto [&>svg]:w-full" aria-label="Private Villa Sibentang">
        <Fragment set:html={wordmark} />
      </a>
      <p class="text-[12px] leading-[1.3] text-ink-2">{t.header.descriptor}</p>
    </div>
    <nav class="flex items-center gap-3 text-[14px] text-ink" aria-label="Bahasa / Language">
      <a href="/" class={lang === "en" ? "font-bold underline underline-offset-2" : "font-normal opacity-80"}>EN</a>
      <a href="/id/" class={lang === "id" ? "font-bold underline underline-offset-2" : "font-normal opacity-80"}>ID</a>
    </nav>
  </div>
</header>
