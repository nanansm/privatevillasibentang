---
// Nav dalam hero, port dari prototipe <nav class="hero-nav">: logo kiri,
// baris tautan di tengah. Duduk di atas video hero (lihat Hero.astro),
// makanya wordmark diwarnai --paper, bukan --ink.
//
// Slot kanan dulu tombol Reservasi WA; sejak 14 Agu 2026 diganti pengalih
// bahasa ID/EN. Ajakan ke WhatsApp tetap ada di seksi Reservasi paling
// bawah, jadi tidak ada jalan masuk yang hilang.
import wordmark from "../assets/brand/lockup-utama.svg?raw";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

// Rute bahasa dikunci di astro.config.mjs: EN default tanpa awalan, ID di
// /id/. trailingSlash 'always', jadi garis miring penutup wajib ada —
// tanpa itu kena redirect satu putaran.
const bahasa = [
  { kode: "id" as const, label: "ID", href: "/id/" },
  { kode: "en" as const, label: "EN", href: "/" },
];
---

<nav class="hero-nav">
  <a class="hero-brand" href="#top" aria-label={t.hero.brandAlt}>
    <Fragment set:html={wordmark} />
  </a>
  <div class="hero-links">
    {t.hero.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </div>
  <div class="hero-lang" role="group" aria-label={t.hero.langSwitchLabel}>
    {
      bahasa.map((b, i) => (
        <>
          {i > 0 && <span class="hero-lang-sep" aria-hidden="true">/</span>}
          <a
            class:list={["hero-lang-opt", { on: b.kode === lang }]}
            href={b.href}
            hreflang={b.kode}
            lang={b.kode}
            aria-current={b.kode === lang ? "true" : undefined}
          >
            {b.label}
          </a>
        </>
      ))
    }
  </div>
</nav>

<style>
  .hero-nav {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 26px 5vw 0;
    gap: 20px;
  }
  .hero-brand {
    display: block;
    width: clamp(120px, 12vw, 168px);
    color: var(--paper);
  }
  .hero-brand :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-links {
    display: flex;
    gap: 34px;
    justify-self: center;
  }
  .hero-links a {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--paper);
    opacity: 0.9;
  }
  .hero-links a:hover {
    opacity: 1;
  }
  /* Kotaknya meneruskan bahasa visual tombol Reservasi yang digantikan:
     border tipis, huruf kapital berjarak, tinggi yang sama. */
  .hero-lang {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(239, 236, 232, 0.55);
    padding: 11px 18px;
  }
  .hero-lang-opt {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--paper);
    /* Yang tidak aktif diredupkan, bukan disembunyikan — pengunjung harus
       bisa lihat ada pilihan lain sebelum menyadari perlu mengekliknya. */
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }
  .hero-lang-opt:hover {
    opacity: 1;
  }
  .hero-lang-opt.on {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }
  .hero-lang-sep {
    font-size: 11.5px;
    color: rgba(239, 236, 232, 0.4);
  }
  @media (max-width: 820px) {
    .hero-links {
      display: none;
    }
    .hero-nav {
      grid-template-columns: 1fr auto;
    }
    .hero-brand {
      width: clamp(100px, 26vw, 140px);
    }
  }
</style>
