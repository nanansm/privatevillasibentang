---
// Halaman tautan untuk bio Instagram.
// Satu tugas: orang yang datang dari bio bisa langsung chat atau memesan.
//
// Foto fasad dipasang penuh tepi ke tepi tanpa sudut membulat. Wordmark
// ditaruh di BAGIAN ATAS foto supaya kolam renang di bawah tidak tertutup.
//
// Dua tata letak, satu markup:
// - Mobile (<768px): tumpukan foto, isi, penutup. Ini bentuk yang sudah
//   disetujui, jadi tidak ada satu pun kelas mobile yang diubah.
// - Desktop (>=768px): panel dua kolom. Foto pindah ke kolom kiri dan
//   memanjang setinggi seluruh panel lewat posisi absolut, isi dan penutup
//   menumpuk di kolom kanan. Tanpa ini halaman jadi kolom 480px terapung di
//   tengah layar 1440px, terbaca seperti tangkapan layar ponsel.
// `Picture`, bukan `Image`. Terbukti di produksi: `Image` tanpa prop `format`
// memakai default Astro, dan halaman ini terkirim WebP saja sementara homepage
// sudah AVIF. Sekarang dua-duanya menawarkan AVIF lebih dulu, WebP sebagai
// cadangan, jadi tidak ada lagi halaman yang tertinggal formatnya.
import { Picture } from "astro:assets";
import wordmark from "../assets/brand/wordmark.svg?raw";
import ornamen from "../assets/brand/ornamen.svg?raw";
// mote-9760 pindah jadi foto hero homepage, jadi halaman ini pakai foto lain
// supaya dua halaman tidak membuka dengan gambar yang sama persis.
//
// mote-9747 dipilih karena tidak ada orang di dalamnya. Ini satu-satunya foto
// di halaman ini yang dipotong `object-cover`, dan rasio potongnya berubah
// jauh antara mobile (0,87) dan desktop (0,67). Foto berisi orang kepalanya
// terpotong di salah satu dari dua rasio itu; foto arsitektur aman di
// dua-duanya. Isinya tetap membuktikan janji halaman: paviliun villa yang
// terbuka langsung ke kolam privat.
// Hero jadi video loop dari footage drone (jalan setapak sisi kolam menuju
// gazebo), potongan 2:3 supaya aman di dua rasio potong halaman ini. Poster
// tetap gambar nyata dan tetap elemen LCP; video menyusul sesudah halaman
// selesai muat, persis pola Hero homepage.
import LoopVideo from "./LoopVideo.astro";
import foto from "../assets/foto2026/v-link-hero-poster.jpg";
import Irama from "./Irama.astro";
import {
  waUrl,
  MAPS_URL,
  IG_URL,
  TRAVELOKA_URL,
  AGODA_URL,
  ALAMAT,
} from "../config";

interface Props { lang?: "id" | "en"; }
const { lang = "id" } = Astro.props;

const t = {
  id: {
    intro: "Sembilan villa privat berkolam air panas alami di Cipanas, Garut.",
    wa: "Chat Admin Sibentang",
    // Teks dipakai apa adanya di dua bahasa, sesuai permintaan, sama seperti
    // "Direct Google Map" yang juga tidak diterjemahkan.
    beranda: "All Information about Sibentang",
    traveloka: "Cek tanggal & harga di Traveloka",
    agoda: "Pesan lewat Agoda",
    maps: "Direct Google Map",
    ig: "Instagram @privatevillasibentang",
    unit: "Sembilan unit, sembilan nama bunga",
    alt: "Paviliun villa Sibentang yang terbuka langsung ke kolam air panas privat di halamannya",
  },
  en: {
    intro: "Nine private villas with natural hot spring pools in Cipanas, Garut.",
    wa: "Chat Admin Sibentang",
    beranda: "All Information about Sibentang",
    traveloka: "Check dates & rates on Traveloka",
    agoda: "Book on Agoda",
    maps: "Direct Google Map",
    ig: "Instagram @privatevillasibentang",
    unit: "Nine villas, nine flower names",
    alt: "A Sibentang villa pavilion opening straight onto its private hot spring pool",
  },
}[lang];

const pesanWa =
  lang === "id"
    ? "Halo, saya mau tanya ketersediaan Private Villa Sibentang."
    : "Hello, I would like to ask about availability at Private Villa Sibentang.";

const tautan = [
  { href: TRAVELOKA_URL, label: t.traveloka },
  { href: AGODA_URL, label: t.agoda },
  { href: MAPS_URL, label: t.maps },
  { href: IG_URL, label: t.ig },
];

const pil =
  "block rounded-full px-6 py-4 text-center text-[0.92rem] transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--olive)";
---

<main
  class="mx-auto max-w-[30rem] bg-(--paper) text-(--ink) md:my-14 md:grid md:max-w-[60rem] md:grid-cols-2 md:grid-rows-[1fr_auto] md:min-h-[36rem]"
>
  <!-- Foto penuh tepi ke tepi. Wordmark di atas, kolam di bawah tetap terlihat. -->
  <div class="relative md:col-start-1 md:row-span-2 md:row-start-1">
    <!-- Kotak hero mengikuti rasio asli klip (2:3), lebar penuh, tinggi
         menyesuaikan. Sebelumnya dikunci 54svh/28rem dan dipotong
         object-cover; sekarang seluruh bingkai video terlihat utuh dan
         halaman boleh jadi lebih panjang. -->
    <div class="relative aspect-[2/3] w-full">
      <LoopVideo
        base="v-link-hero"
        poster={foto}
        alt={t.alt}
        widths={[390, 585, 780, 960]}
        sizes="(max-width: 480px) 100vw, 480px"
        fill
        eager
        pos="38% center"
      />
    </div>

    <div
      class="absolute inset-x-0 top-0 bg-linear-to-b from-(--ink) via-(--ink)/70 to-transparent px-6 pt-7 pb-16 md:px-8 md:pt-9"
    >
      <div
        class="w-[62%] text-(--paper) md:w-[58%] [&>svg]:h-auto [&>svg]:w-full"
        set:html={wordmark}
      />
      <p class="mt-3 text-[0.6rem] font-medium tracking-[0.28em] text-(--sage)">
        SUNDANESE THERMAL ESCAPE
      </p>
    </div>
  </div>

  <div class="px-6 pt-7 pb-10 md:col-start-2 md:row-start-1 md:flex md:flex-col md:justify-center md:px-10 md:py-12">
    <p class="text-center text-[0.95rem] leading-[1.6] text-(--ink)/82">{t.intro}</p>

    <div class="mt-7 space-y-3">
      <a
        href={waUrl(pesanWa)}
        target="_blank"
        rel="noopener"
        class={`${pil} bg-(--ink) font-bold text-(--paper)`}
      >
        {t.wa}
      </a>

      {/* Satu-satunya tautan ke dalam situs sendiri, jadi tanpa target="_blank"
          dan tanpa rel="noopener" — membuka tab baru untuk halaman sendiri cuma
          menumpuk tab. Ditaruh tepat di bawah tombol WhatsApp karena inilah
          langkah lanjut yang wajar buat orang yang belum siap chat. */}
      <a
        href={lang === "id" ? "/id/" : "/"}
        class={`${pil} border border-(--olive)/45 bg-transparent font-medium text-(--ink)`}
      >
        {t.beranda}
      </a>

      {
        tautan.map((b) => (
          <a
            href={b.href}
            target="_blank"
            rel="noopener"
            class={`${pil} border border-(--olive)/45 bg-transparent font-medium text-(--ink)`}
          >
            {b.label}
          </a>
        ))
      }
    </div>

    <!-- Sembilan ikon = sembilan unit. Penanda yang membawa informasi, bukan hiasan. -->
    <div class="mt-10">
      <Irama class="text-(--sage)" size="0.65rem" />
      <p class="mt-3 text-center text-[0.7rem] text-(--ink)/82">{t.unit}</p>
    </div>
  </div>

  <footer class="bg-(--ink) px-6 py-10 text-center text-(--paper) md:col-start-2 md:row-start-2 md:px-10 md:py-8">
    <!-- Susunan baris bawah lockup resmi: keterangan tipe · ornamen · pengakuan
         induk. Tanpa wordmark, karena wordmark sudah dipakai di atas foto. -->
    <div class="flex items-center justify-center gap-3">
      <span class="text-[0.58rem] font-semibold tracking-[0.16em] whitespace-nowrap">
        SIGNATURE PRIVATE VILLA
      </span>
      <span
        class="block w-[0.9rem] shrink-0 text-(--paper) [&>svg]:h-auto [&>svg]:w-full"
        set:html={ornamen}
      />
      <span class="text-left text-[0.58rem] leading-[1.35] font-semibold tracking-[0.1em]">
        BY KAMPUNG<br />SUMBER ALAM
      </span>
    </div>

    <p class="mt-7 text-[0.7rem] leading-[1.7] text-(--paper)/70">{ALAMAT}</p>
  </footer>
</main>
