---
// Interior villa: dua foto offset, bukan grid seragam. Register di atasnya
// pakai mosaik tile, journeys di bawahnya pakai daftar kode besar — ritme
// section ini sengaja beda: sepasang foto bertingkat.
import { Picture } from "astro:assets";
import kamar from "../assets/photos/mote-9726.jpg";
import ruangDuduk from "../assets/photos/mote-9743.jpg";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

const altA =
  lang === "en"
    ? "A villa bedroom with the yard and its private pool visible beyond."
    : "Kamar tidur villa dengan halaman dan kolam privatnya terlihat di baliknya.";
const altB =
  lang === "en"
    ? "An open living space at the edge of the pool."
    : "Ruang duduk terbuka di tepi kolam.";
---

<section class="mt-24 md:mt-40">
  <div class="mx-auto w-full max-w-[76rem] px-6 md:px-10">
    <div class="md:grid md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-5">
    <h2
      class="muncul max-w-[17ch] text-[29px] leading-[1.15] font-bold tracking-[-0.02em] text-balance text-ink md:text-[44px] md:leading-[1.08]"
    >
      {t.insideVilla.h2}
    </h2>
    <p class="muncul mt-5 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
      {t.insideVilla.body}
    </p>
    </div>

    <div class="md:col-span-7">
    <div class="md:grid md:grid-cols-2 md:gap-6 md:items-start">
      <figure class="muncul mt-10">
        <Picture
          src={kamar}
          alt={altA}
          widths={[390, 780, 960]}
          sizes="(min-width:768px) 28vw, 100vw"
          formats={["avif", "webp"]}
          loading="lazy"
          class="h-auto w-full"
        />
        <figcaption class="mt-3 text-[13px] leading-[1.5] text-ink-2">
          {t.insideVilla.captionA}
        </figcaption>
      </figure>

      <figure class="muncul mt-10">
        <Picture
          src={ruangDuduk}
          alt={altB}
          widths={[390, 780, 960]}
          sizes="(min-width:768px) 28vw, 100vw"
          formats={["avif", "webp"]}
          loading="lazy"
          class="h-auto w-full"
        />
        <figcaption class="mt-3 text-[13px] leading-[1.5] text-ink-2">
          {t.insideVilla.captionB}
        </figcaption>
      </figure>
    </div>
    </div>
    </div>
  </div>
</section>
