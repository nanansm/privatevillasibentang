---
// Villa jadi pengalaman yang terasa.
// Dua foto dipasang utuh, berdampingan di desktop. Tidak ada yang ditumpuk,
// tidak ada yang dipotong jadi pita, supaya isi tiap foto kebaca penuh.
import { Picture } from "astro:assets";
import paviliun from "../assets/photos/mote-9746.jpg";
import lorong from "../assets/photos/mote-9775.jpg";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];

const altPaviliun =
  lang === "en"
    ? "The open pavilion beside the pool inside the Sibentang estate."
    : "Paviliun terbuka di tepi kolam di kawasan Sibentang.";
const altLorong =
  lang === "en"
    ? "A green pathway between the villas inside the estate."
    : "Lorong hijau di antara villa di dalam kawasan.";
---

<section class="mt-24 md:mt-40">
  <div class="mx-auto w-full max-w-[76rem] px-6 md:px-10 md:grid md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-5 md:row-start-1">
      <h2
        class="muncul max-w-[17ch] text-[29px] leading-[1.15] font-bold tracking-[-0.02em] text-balance text-ink md:text-[44px] md:leading-[1.08]"
      >
        {t.oneGate.h2}
      </h2>
      <p class="muncul mt-5 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
        {t.oneGate.body}
      </p>
    </div>

    <div class="muncul mt-10 md:col-span-7 md:col-start-6 md:row-start-1 md:row-span-2 md:mt-0 md:grid md:grid-cols-2 md:items-start md:gap-6">
      <Picture
        src={paviliun}
        alt={altPaviliun}
        widths={[390, 780, 1170]}
        sizes="(min-width: 768px) 29vw, 100vw"
        formats={["avif", "webp"]}
        loading="lazy"
        class="h-auto w-full"
      />
      <Picture
        src={lorong}
        alt={altLorong}
        widths={[390, 780, 1170]}
        sizes="(min-width: 768px) 29vw, 100vw"
        formats={["avif", "webp"]}
        loading="lazy"
        class="mt-10 h-auto w-full md:mt-0"
      />
    </div>

    <div class="mt-10 border-t border-rule pt-6 md:col-span-5 md:row-start-2">
      <h3 class="muncul text-[17px] leading-[1.35] font-semibold text-ink">
        {t.oneGate.spaH3}
      </h3>
      <p class="mt-2 max-w-[38ch] text-[17px] leading-[1.6] text-ink md:text-[18px]">
        {t.oneGate.spaBody}
      </p>
    </div>
  </div>
</section>
