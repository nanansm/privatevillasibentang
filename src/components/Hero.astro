---
// Port dari prototipe <header class="hero" id="top">: full-bleed, gradasi
// gelap, nav (SiteHeader), lalu blok bawah (kicker, h1, garis dua label).
// Video main di SEMUA ukuran layar, dipotong object-fit:cover, sama seperti
// prototipe — tidak ada split desktop/mobile.
//
// Strategi muat beda dari prototipe (prototipe muat video seketika via
// autoplay+preload=auto): poster jadi elemen LCP (astro:assets <Picture>,
// avif+webp, eager+fetchpriority high), video TANPA src saat HTML pertama
// (cuma data-src) dan ditumpuk opacity:0 di atas poster. Baru sesudah
// window load + requestIdleCallback video di-load lalu di-play dan
// difadekan masuk. Kalau play() ditolak browser, poster tetap tampil —
// tidak ada state rusak.
//
// Catatan komponen: <Image> astro:assets cuma menerima satu `format`, bukan
// `formats` jamak — cuma <Picture> yang bisa keluarkan <source> avif+webp
// dengan fallback, jadi dipakai di sini (pola yang sama dipakai
// Biolink.astro, lihat catatannya soal Image vs Picture).
import { Picture } from "astro:assets";
import heroPoster from "../assets/foto2026/hero-jalan-portrait-poster.jpg";
import SiteHeader from "./SiteHeader.astro";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---

<header class="hero" id="top">
  <div class="hero-media">
    <Picture
      src={heroPoster}
      alt=""
      widths={[540, 810, 1080]}
      sizes="100vw"
      formats={["avif", "webp"]}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: "hero-poster-frame" }}
      class="hero-poster"
    />
    <video
      class="hero-video"
      id="heroVideo"
      muted
      loop
      playsinline
      preload="none"
      data-src-portrait="/video/hero-jalan-portrait"
      data-src-wide="/video/hero-jalan-wide"
      aria-hidden="true"
    ></video>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <SiteHeader lang={lang} />

  <div class="hero-bottom">
    <span class="kicker">{t.hero.kicker}</span>
    <div class="hero-flex">
      <h1>{t.hero.h1}</h1>
    </div>
    <div class="hero-rule">
      <span>{t.hero.ruleLabels[0]}</span>
      <span>{t.hero.ruleLabels[1]}</span>
    </div>
  </div>
</header>

<script>
  (function () {
    var video = document.getElementById("heroVideo");
    if (!(video instanceof HTMLVideoElement)) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function loadVideo() {
      // Dua encode: potret buat layar tinggi (HP), lanskap buat layar lebar.
      // Sebelumnya cuma ada satu berkas potret, jadi di desktop 720px lebarnya
      // dipaksa melar ke 1920px dan kelihatan lembek.
      var wide = matchMedia("(min-aspect-ratio: 1/1)").matches;
      var base = video.getAttribute(wide ? "data-src-wide" : "data-src-portrait");
      if (!base) return;
      // AV1/WebM dulu (lebih kecil), H.264 sebagai jaring pengaman.
      [
        [".webm", "video/webm"],
        [".mp4", "video/mp4"],
      ].forEach(function (pair) {
        var source = document.createElement("source");
        source.src = base + pair[0];
        source.type = pair[1];
        video.appendChild(source);
      });
      video.load();
      video.addEventListener(
        "canplay",
        function onCanPlay() {
          video.removeEventListener("canplay", onCanPlay);
          var playPromise = video.play();
          if (playPromise && typeof playPromise.then === "function") {
            playPromise
              .then(function () {
                video.classList.add("is-visible");
              })
              .catch(function () {
                /* biarkan poster tetap tampil */
              });
          } else {
            video.classList.add("is-visible");
          }
        },
        { once: true },
      );
    }

    // Sebelumnya digantung di event 'load', yang baru menyala setelah SEMUA
    // gambar (termasuk yang lazy di bawah lipatan) selesai. Terukur: video
    // baru mulai diunduh di 2.145 ms, fade-nya kelar ~2,8 dtk, dan itulah
    // yang menahan LCP di 2,9 dtk padahal halaman sudah terlihat utuh di
    // 0,9 dtk. Sekarang dijadwalkan lewat idle callback ber-timeout, jadi
    // video menyusul sesaat setelah jalur kritis kosong, bukan setelah
    // seluruh halaman selesai.
    window.addEventListener("load", function () {
      if ("requestIdleCallback" in window) {
        (window as any).requestIdleCallback(loadVideo);
      } else {
        setTimeout(loadVideo, 200);
      }
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media :global(.hero-poster-frame) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-media :global(.hero-poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hero-video.is-visible {
    opacity: 1;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(30, 24, 8, 0.5) 0%,
      rgba(30, 24, 8, 0.08) 40%,
      rgba(30, 24, 8, 0.62) 100%
    );
  }
  .hero-bottom {
    position: relative;
    z-index: 5;
    margin-top: auto;
    padding: 0 5vw 44px;
  }
  .hero-bottom .kicker {
    color: rgba(239, 236, 232, 0.85);
    display: block;
    margin-bottom: 14px;
  }
  .hero-flex {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  h1 {
    font-size: clamp(2.3rem, 4.8vw, 4.2rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }
  .hero-rule {
    margin-top: 34px;
    border-top: 1px solid rgba(239, 236, 232, 0.25);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-rule span {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(239, 236, 232, 0.7);
  }
</style>
