---
// Port dari prototipe <header class="hero" id="top">: full-bleed, gradasi
// gelap, nav (SiteHeader), lalu blok bawah (kicker, h1, garis dua label).
// Video main di SEMUA ukuran layar, dipotong object-fit:cover, sama seperti
// prototipe — tidak ada split desktop/mobile.
//
// Strategi muat beda dari prototipe (prototipe muat video seketika via
// autoplay+preload=auto): poster jadi elemen LCP (astro:assets <Picture>,
// avif+webp, eager+fetchpriority high), video TANPA src saat HTML pertama
// (cuma data-src) dan ditumpuk opacity:0 di atas poster. Baru sesudah
// window load + requestIdleCallback video di-load lalu di-play dan
// difadekan masuk. Kalau play() ditolak browser, poster tetap tampil —
// tidak ada state rusak.
//
// Catatan komponen: <Image> astro:assets cuma menerima satu `format`, bukan
// `formats` jamak — cuma <Picture> yang bisa keluarkan <source> avif+webp
// dengan fallback, jadi dipakai di sini (pola yang sama dipakai
// Biolink.astro, lihat catatannya soal Image vs Picture).
import { Picture } from "astro:assets";
import heroPoster from "../assets/foto2026/hero-jalan-portrait-poster.jpg";
import SiteHeader from "./SiteHeader.astro";
import { copy, type Lang } from "../i18n/copy";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---

<header class="hero" id="top">
  <div class="hero-media">
    <Picture
      src={heroPoster}
      alt=""
      widths={[540, 810, 1080]}
      sizes="100vw"
      formats={["avif", "webp"]}
      quality={45}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: "hero-poster-frame" }}
      class="hero-poster"
    />
    <video
      class="hero-video"
      id="heroVideo"
      muted
      loop
      playsinline
      preload="none"
      data-src-portrait="/video/hero-jalan-portrait"
      data-src-wide="/video/hero-jalan-wide"
      aria-hidden="true"
    ></video>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <SiteHeader lang={lang} />

  <div class="hero-bottom">
    <span class="kicker">{t.hero.kicker}</span>
    <div class="hero-flex">
      <h1>{t.hero.h1}</h1>
    </div>
    <div class="hero-rule">
      <span>{t.hero.ruleLabels[0]}</span>
      <span>{t.hero.ruleLabels[1]}</span>
    </div>
  </div>
</header>

<script>
  (function () {
    var video = document.getElementById("heroVideo");
    if (!(video instanceof HTMLVideoElement)) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    function loadVideo() {
      // Dua encode: potret buat layar tinggi (HP), lanskap buat layar lebar.
      // Sebelumnya cuma ada satu berkas potret, jadi di desktop 720px lebarnya
      // dipaksa melar ke 1920px dan kelihatan lembek.
      var wide = matchMedia("(min-aspect-ratio: 1/1)").matches;
      var base = video.getAttribute(wide ? "data-src-wide" : "data-src-portrait");
      if (!base) return;
      // AV1/WebM dulu (lebih kecil), H.264 sebagai jaring pengaman.
      [
        [".webm", "video/webm"],
        [".mp4", "video/mp4"],
      ].forEach(function (pair) {
        var source = document.createElement("source");
        source.src = base + pair[0];
        source.type = pair[1];
        video.appendChild(source);
      });
      video.load();
      // Jaring pengaman: kalau berkas 404/kodek tidak didukung, canplay
      // tidak akan pernah nyala — jangan gantung diam-diam, minimal ada
      // jejak di console buat debug lintas-perangkat.
      var gagal = setTimeout(function () {
        console.warn("[hero] video canplay timeout, poster tetap tampil");
      }, 8000);
      video.addEventListener(
        "canplay",
        function onCanPlay() {
          clearTimeout(gagal);
          video.removeEventListener("canplay", onCanPlay);
          var playPromise = video.play();
          if (playPromise && typeof playPromise.then === "function") {
            playPromise
              .then(function () {
                video.classList.add("is-visible");
              })
              .catch(function () {
                /* biarkan poster tetap tampil */
              });
          } else {
            video.classList.add("is-visible");
          }
        },
        { once: true },
      );
    }

    // Elemen LCP halaman ini bukan gambar, tapi teks <h1> — dan teks itu
    // menunggu KumbhSans.woff2. Kalau video ikut diminta di jendela yang
    // sama, 626 KB itu berebut bandwidth dengan font dan LCP molor (pernah
    // tercatat 4,8 dtk di PageSpeed produksi).
    //
    // Versi lama gantung video di 'load' (baru nyala sesudah SEMUA resource
    // halaman kelar — bisa molor tak terduga) + jaring pengaman 10 detik +
    // WAJIB ada interaksi pengunjung. Di lapangan itu kepanjangan/rapuh:
    // dilaporkan video sama sekali tidak jalan di beberapa laptop & HP
    // (27 Agu 2026). Sinyal yang dipakai sekarang jauh lebih tepat sasaran:
    // document.fonts.ready — persis saat font LCP itu kelar, bukan nunggu
    // seluruh halaman — dengan jaring pengaman 3 detik kalau API-nya tidak
    // ada/macet. Tidak butuh interaksi sama sekali; interaksi cuma jalur
    // cepat kalau kejadian duluan. Poster tetap tampil selama jeda.
    var mulai = false;
    function jadwalkan() {
      if (mulai) return;
      mulai = true;
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(loadVideo, { timeout: 500 });
      } else {
        loadVideo();
      }
    }

    var pengaman = setTimeout(jadwalkan, 3000);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        clearTimeout(pengaman);
        jadwalkan();
      });
    }
    ["pointerdown", "scroll", "keydown", "touchstart"].forEach(function (ev) {
      window.addEventListener(
        ev,
        function () {
          clearTimeout(pengaman);
          jadwalkan();
        },
        { once: true, passive: true },
      );
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    color: var(--paper);
    isolation: isolate;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }
  .hero-media :global(.hero-poster-frame) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .hero-media :global(.hero-poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hero-video.is-visible {
    opacity: 1;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(30, 24, 8, 0.5) 0%,
      rgba(30, 24, 8, 0.08) 40%,
      rgba(30, 24, 8, 0.62) 100%
    );
  }
  .hero-bottom {
    position: relative;
    z-index: 5;
    margin-top: auto;
    padding: 0 5vw 44px;
  }
  .hero-bottom .kicker {
    color: rgba(239, 236, 232, 0.85);
    display: block;
    margin-bottom: 14px;
  }
  .hero-flex {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  h1 {
    font-size: clamp(2.3rem, 4.8vw, 4.2rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }
  .hero-rule {
    margin-top: 34px;
    border-top: 1px solid rgba(239, 236, 232, 0.25);
    padding-top: 16px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero-rule span {
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(239, 236, 232, 0.7);
  }
</style>
